      "id": "0ad2feb3-07d2-45c2-b4da-69faa5b0f506",
      "name": "OpenRegister Company Search"
    },
    {
      "parameters": {
        "jsCode": "\nconst input = $('Edit Fields').first().json;\nconst response = $input.first().json;\n\nconst requestedName = input.company_name.trim();\nconst results = response.results || [];\n\nfunction normalize(value) {\n  return String(value || '')\n    .normalize('NFKC')\n    .toLowerCase()\n    .replace(/[.,]/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nconst exactMatches = results.filter(\n  company => normalize(company.name) === normalize(requestedName)\n);\n\nconst selected = exactMatches.length === 1\n  ? exactMatches[0]\n  : null;\n\nreturn [{\n  json: {\n    requested_company: requestedName,\n    jurisdiction: input.jurisdiction,\n    include_financials: input.include_financials,\n    match_status: selected\n      ? 'verified'\n      : exactMatches.length > 1\n        ? 'ambiguous'\n        : 'not_verified',\n    company_id: selected?.company_id || null,\n    company_name: selected?.name || null,\n    register_court: selected?.register_court || null,\n    register_number: selected?.register_number || null,\n    candidates: selected ? [] : results.map(c => ({\n      name: c.name,\n      company_id: c.company_id,\n      register_court: c.register_court,\n      register_number: c.register_number\n    }))\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
