{
  "name": "INCEPT \u2014 Temporary Google Sheets Read-Only Test",
  "active": false,
  "nodes": [
    {
      "id": "54ec8f5265ae53649dc820e77bf1b8d5",
      "name": "Manual Read Test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "fdf67aff6fb353f78cf971a32b388d06",
      "name": "Discover Spreadsheets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        200,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "mimeType = 'application/vnd.google-apps.spreadsheet' and trashed = false and 'me' in owners"
            },
            {
              "name": "fields",
              "value": "nextPageToken,files(id,name,owners(emailAddress))"
            },
            {
              "name": "pageSize",
              "value": "100"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": false
    },
    {
      "id": "4d0b922fb67355ee815f89b779c7b4c2",
      "name": "Choose Spreadsheet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst response=$input.first().json;\nif(response.statusCode!==200 || !response.body || !Array.isArray(response.body.files)) throw new Error('spreadsheet_metadata_read_failed');\nif(response.body.nextPageToken) throw new Error('metadata_selection_incomplete: more than one page; no automatic selection');\nconst files=response.body.files.filter(f=>Array.isArray(f.owners) && f.owners.some(o=>o.emailAddress==='ironhackproject3@gmail.com'));\nif(files.length!==1) return [{json:{selection_status:files.length?'ambiguous':'not_found',candidates:files.map(f=>({id:f.id,name:f.name})),read_permitted:false}}];\nreturn [{json:{selection_status:'unique',spreadsheet_id:files[0].id,spreadsheet_name:files[0].name,read_permitted:true}}];\n"
      }
    },
    {
      "id": "40d003b74ce453aaaa8813a2325f4818",
      "name": "Unique Spreadsheet?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "4eb538e447725025b4ed1f7b50845c53",
              "leftValue": "={{ $json.read_permitted === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f17b9a9b36995cf9b2d1b3cc8ee3f90e",
      "name": "Discover Worksheets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        800,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://sheets.googleapis.com/v4/spreadsheets/' + encodeURIComponent($json.spreadsheet_id) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "sheets.properties"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": false
    },
    {
      "id": "0bc66466ff2c5bfb83c0bcf65bd71f91",
      "name": "Choose Worksheet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst response=$input.first().json;\nif(response.statusCode!==200 || !Array.isArray(response.body?.sheets)) throw new Error('worksheet_metadata_read_failed');\nconst tabs=response.body.sheets.filter(s=>s.properties?.sheetType==='GRID').map(s=>s.properties);\nconst document=$('Choose Spreadsheet').first().json;\nif(tabs.length!==1) return [{json:{...document,selection_status:'ambiguous_tabs',read_permitted:false,tab_candidates:tabs.map(t=>({id:t.sheetId,title:t.title}))}}];\nreturn [{json:{...document,tab_id:tabs[0].sheetId,tab_title:tabs[0].title,read_permitted:true}}];\n"
      }
    },
    {
      "id": "24b952ba8aed504ab0d2f5682bf3c8c4",
      "name": "Unique Worksheet?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "12ebb6d91a155fecb26685130bf117bd",
              "leftValue": "={{ $json.read_permitted === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "647d9009c46057e484ba4c837d4aaa36",
      "name": "Get Real Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "authentication": "oAuth2",
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.spreadsheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "id",
          "value": "={{ String($json.tab_id) }}"
        },
        "options": {
          "dataLocationOnSheet": {
            "values": {
              "rangeDefinition": "specifyRangeA1",
              "range": "A1:Z101"
            }
          },
          "returnFirstMatch": false
        }
      },
      "retryOnFail": false
    },
    {
      "id": "75f0c4c30bb65b44a1fa5f25d4dd1198",
      "name": "Sanitized Read Proof",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst rows=$input.all().map(i=>i.json);\nconst meaningful=rows.filter(r=>Object.entries(r).some(([k,v])=>k!=='row_number' && v!==null && v!==''));\nif(meaningful.length===0) throw new Error('no_real_rows_returned');\nconst selected=$('Choose Worksheet').first().json;\nreturn [{json:{product:'INCEPT',integration:'Google Sheets',n8n_execution_id:String($execution.id),\n spreadsheet_id:selected.spreadsheet_id,spreadsheet_name:selected.spreadsheet_name,tab_id:selected.tab_id,tab_title:selected.tab_title,\n status:'passed',rows_returned:meaningful.length,column_count:new Set(meaningful.flatMap(r=>Object.keys(r).filter(k=>k!=='row_number'))).size,\n range:'A1:Z101',read_only:true,spreadsheet_writes:0,emails_sent:0,calendar_events_created:0,\n response_mocked:false,credential_secrets_exported:false,completed_at:new Date().toISOString()}}];\n"
      }
    },
    {
      "id": "c57bcd1f52b151c7b87855da5caae4f1",
      "name": "Selection Needs Review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nreturn [{json:{product:'INCEPT',status:'selection_requires_review',...$input.first().json,\n n8n_execution_id:String($execution.id),spreadsheet_writes:0}}];\n"
      }
    }
