    {
      "id": "b94dbf1629a456fdac69764aa9ee03a0",
      "name": "List Recent Gmail IDs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages?q=in%3Ainbox+-in%3Aspam+-in%3Atrash&maxResults=8",
        "options": {
          "timeout": 20000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
