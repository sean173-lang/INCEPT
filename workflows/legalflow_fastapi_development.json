    {
      "id": "f65c3181-fa5c-5c6c-a36b-b0622f1b94cd",
      "name": "Validate Candidate Selection",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2660,
        280
      ],
      "parameters": {
        "jsCode": "\nconst context = $('Prepare Company Candidates').first().json;\nconst choice = $input.first().json['Company Candidate'];\nconst matches = context.candidates.filter(c => `${c.provider_company_id} | ${c.name} | ${c.register_court || 'UK register'}` === choice);\nif (matches.length !== 1) return [{json:{...context, status:'verification_failed', message:'Invalid or ambiguous candidate selection.'}}];\nconst c = matches[0];\nconst verification_request = {company_name:c.name, jurisdiction:c.jurisdiction, provider_company_id:c.provider_company_id};\nif (c.registration_number) verification_request.registration_number = c.registration_number;\nif (c.jurisdiction === 'Germany' && c.register_court) verification_request.register_court = c.register_court;\nif (c.jurisdiction === 'Germany' && ['HRB','HRA'].includes(c.register_type)) verification_request.register_type = c.register_type;\nreturn [{json:{...context, status:'selected', verification_request, message:'Candidate selected; details verification required.'}}];\n"
      }
    },
