    {
      "id": "bef977f0-ddef-5028-86c6-ca529206b073",
      "name": "FastAPI Company Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "retryOnFail": false,
      "onError": "continueRegularOutput",
      "position": [
        1560,
