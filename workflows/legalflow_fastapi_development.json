      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/v1/company/search",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
