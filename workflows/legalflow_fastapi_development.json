    {
      "id": "a8bc1820-ddd6-5d8a-93d2-6ccd8b417919",
      "name": "Require Development Mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "jsCode": "\nconst context = $('Prepare Development Input').first().json;\nconst response = $input.first().json;\nconst body = response.body;\nconst ready = response.statusCode === 200 && body?.status === 'ok' && body?.development === true;\nreturn [{json: {...context, ready, status: ready ? 'pending' : 'verification_failed',\n  message: ready ? 'FastAPI development mode confirmed.' : 'FastAPI unavailable or not in development mode; workflow stopped.'}}];\n"
      }
    },
