    {
      "id": "ecc67ae7-9f67-58cf-be7f-6e1a74f0fa94",
      "name": "Prepare Development Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\nconst jurisdiction = input.jurisdiction;\nconst requested = typeof input.company_name === 'string' ? input.company_name.trim() : '';\nconst valid = requested.length > 0 && requested.length <= 200 && !/[\\x00-\\x1f\\x7f]/.test(requested)\n  && ['Germany', 'UK'].includes(jurisdiction);\nreturn [{json: {requested_company: requested, jurisdiction,\n  requested_include_financials: input.include_financials === true,\n  include_financials: false, financial_requests_enabled: false, development: true,\n  company_name: jurisdiction === 'UK' ? 'LEGALFLOW DEMO LTD' : 'LEGALFLOW DEMO GmbH',\n  ready: valid, status: valid ? 'pending' : 'verification_failed',\n  message: valid ? 'Development fixtures only; requested real company will not be queried.' : 'Company name and Germany/UK jurisdiction are required.'}}];\n"
      }
    },
