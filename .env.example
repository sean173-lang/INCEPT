# Optional provider credentials; development fixtures need no provider keys.
COMPANIES_HOUSE_API_KEY=
OPENREGISTER_API_KEY=
TAVILY_API_KEY=
# Legacy environment variable names retained for compatibility; fail closed by default.
LEGALFLOW_SERVICE_MODE=development
LEGALFLOW_SERVICE_ALLOW_PAID=0
LEGALFLOW_SERVICE_MAX_OR_CREDITS=0
LEGALFLOW_SERVICE_MAX_TAVILY_SEARCHES=0
LEGALFLOW_SERVICE_MAX_SPEND=0
LEGALFLOW_SERVICE_TOKEN=
# Optional local n8n administration; never export OAuth tokens or credential contents.
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=

# Optional AI synthesis; these defaults prohibit all model requests.
OPENAI_API_KEY=
INCEPT_AI_MODEL=
INCEPT_AI_LIVE_ENABLED=0
INCEPT_AI_BILLING_VERIFIED=0
INCEPT_AI_APPROVAL_ID=
INCEPT_AI_MAX_REQUESTS=0
INCEPT_AI_MAX_INPUT_TOKENS=32000
INCEPT_AI_MAX_OUTPUT_TOKENS=3000
INCEPT_AI_MAX_TOTAL_TOKENS=0
INCEPT_AI_TIMEOUT_SECONDS=20
